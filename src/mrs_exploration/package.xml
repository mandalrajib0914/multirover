  <version>0.1.0</version>
  <description>Frontier exploration (explore_lite config, run monitor; the S6 coordinator goes here too)</description>
  <maintainer email="linearwebsolution@gmail.com">rajib-mandal</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>explore_lite</exec_depend>
  <exec_depend>explore_lite_msgs</exec_depend>
  <exec_depend>mrs_bringup</exec_depend>
  <exec_depend>mrs_gazebo</exec_depend>
