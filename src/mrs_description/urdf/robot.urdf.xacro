<?xml version="1.0"?>
<!--
  Multirover differential-drive robot.
  xacro args:
    prefix     frame prefix, "" for a single robot, "robot1/" in S6
    namespace  gz topic namespace, "" for a single robot, "robot1" in S6
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mrs_robot">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="namespace" default=""/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="namespace" value="$(arg namespace)"/>
  <!-- gz topic prefix: "" or "robot1/" -->
  <xacro:property name="gz_ns" value="${namespace + '/' if namespace else ''}"/>

  <!-- ===== Dimensions (placeholders until the real robot is measured) ===== -->
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.20"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width" value="0.16"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass" value="1.0"/>
  <!-- chassis centre relative to the wheel axle (base_link) -->
  <xacro:property name="chassis_x" value="-0.03"/>

  <xacro:property name="caster_radius" value="${wheel_radius / 2}"/>
  <xacro:property name="caster_x" value="-0.10"/>
  <xacro:property name="caster_mass" value="0.02"/>

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.10"/>

  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="robot_core.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <xacro:include filename="camera.xacro"/>
  <xacro:include filename="imu.xacro"/>
  <xacro:include filename="gz_plugins.xacro"/>

</robot>
