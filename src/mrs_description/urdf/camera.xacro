<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Forward-facing camera on the chassis front face -->
  <joint name="${prefix}camera_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}camera_link"/>
    <origin xyz="${chassis_x + chassis_length / 2 + 0.005} 0 ${chassis_height - 0.015}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}camera_link">
    <visual>
      <geometry><box size="0.01 0.03 0.02"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.01 0.03 0.02"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.01" x="0.01" y="0.03" z="0.02">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ROS optical convention: z forward, x right, y down -->
  <joint name="${prefix}camera_optical_joint" type="fixed">
    <parent link="${prefix}camera_link"/>
    <child link="${prefix}camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="${prefix}camera_link_optical"/>

  <!-- gz cameras look along +x of the sensor link, so the sensor lives on camera_link
       and the images are stamped with the optical frame. -->
  <gazebo reference="${prefix}camera_link">
    <sensor name="camera" type="camera">
      <topic>${gz_ns}camera/image_raw</topic>
      <camera_info_topic>${gz_ns}camera/camera_info</camera_info_topic>
      <gz_frame_id>${prefix}camera_link_optical</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
